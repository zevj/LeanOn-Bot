APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Security Configuration ────────────────────────────────────
# E2E API Encryption Key (256-bit Hex — 64 characters)
# Generate: php -r "echo bin2hex(random_bytes(32));"
API_ENCRYPTION_KEY=

# HMAC Request Signing Key (256-bit Hex — 64 characters)
# Generate: php -r "echo bin2hex(random_bytes(32));"
# Must match VITE_HMAC_SECRET_KEY in frontend .env
HMAC_SECRET_KEY=

# Frontend URL for CORS and CSP (your Vercel deployment URL)
FRONTEND_URL=http://localhost:5173

# Cloudflare Configuration ─────────────────────────────────
# Enable ONLY after pointing your domain through Cloudflare
CLOUDFLARE_PROXY_ENABLED=false
TURNSTILE_SECRET_KEY=

# ── Production Settings (set these on Render) ────────────────
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=none

# ── AI Analytics & Insights ───────────────────────────────────
# Provider for AI insight generation (gemini, mock)
AI_INSIGHTS_PROVIDER=gemini
AI_INSIGHTS_GEMINI_MODEL=gemini-2.5-flash
# Key #2: Dedicated Gemini API key for analytics — separate quota from chat bot (GEMINI_API_KEY)
AI_INSIGHTS_GEMINI_KEY=
# Key #3: Fallback analytics key — used if Key #2 hits quota (optional)
AI_INSIGHTS_GEMINI_FALLBACK_KEY=
# Cache TTL in seconds (default: 24 hours — AI runs once per day only)
AI_INSIGHTS_CACHE_TTL=86400
# Cooldown after quota failure — prevents retry spam (default: 6 hours)
AI_INSIGHTS_COOLDOWN_TTL=21600
# Max retries on non-quota failures (keep low — 1 is enough)
AI_INSIGHTS_MAX_RETRIES=1
AI_INSIGHTS_TIMEOUT=25
# Keep output tokens LOW — compact JSON only (300-600 is sufficient)
AI_INSIGHTS_MAX_OUTPUT_TOKENS=600
