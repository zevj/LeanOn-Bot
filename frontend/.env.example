# E2E API Encryption Key (256-bit Hex — 64 characters)
# Must match API_ENCRYPTION_KEY in backend .env
VITE_API_ENCRYPTION_KEY=

# Backend API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# HMAC Request Signing Key (256-bit Hex — 64 characters)
# Must match HMAC_SECRET_KEY in backend .env
VITE_HMAC_SECRET_KEY=

# Cloudflare Turnstile Site Key (Public)
VITE_TURNSTILE_SITE_KEY=
